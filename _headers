/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self' https:; connect-src 'self' https: wss://*.firebaseio.com wss://*.firebasedatabase.app script.google.com script.googleusercontent.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: cdn.jsdelivr.net unpkg.com; style-src 'self' 'unsafe-inline' https: cdn.jsdelivr.net unpkg.com; img-src 'self' https: data: blob: *.openstreetmap.org *.tile.openstreetmap.org files.catbox.moe catbox.moe; media-src 'self' https: data: blob: files.catbox.moe catbox.moe; font-src 'self' https: data:;
